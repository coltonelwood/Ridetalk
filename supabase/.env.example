# Supabase edge function secrets (set via `supabase secrets set …`, NOT committed).
# Used by functions/livekit-token to mint LiveKit access tokens server-side.

LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx
LIVEKIT_URL=wss://your-project.livekit.cloud

# These are provided automatically in the Supabase Functions runtime, shown here for local dev:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
