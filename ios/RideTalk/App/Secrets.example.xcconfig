// RideTalk secrets — COPY THIS FILE to `Secrets.xcconfig` and fill in real values.
// `Secrets.xcconfig` is gitignored. These are surfaced into Info.plist build settings and
// read at runtime by AppConfig.
//
//   cp RideTalk/App/Secrets.example.xcconfig RideTalk/App/Secrets.xcconfig
//
// NOTE: xcconfig does not allow `//` inside a value (it's a comment). The URL scheme is
// split so the `//` in https:// doesn't get eaten — AppConfig reassembles it. Just store
// the host without the scheme, or use the SUPABASE_URL_HOST style below.

// Supabase project URL, e.g. abcdxyz.supabase.co  (host only, no scheme)
SUPABASE_URL_HOST = your-project.supabase.co

// Supabase anon/public key (safe to ship in-app; RLS protects data)
SUPABASE_ANON_KEY = your-anon-public-key

// LiveKit WebSocket URL host, e.g. your-project.livekit.cloud  (host only, no scheme)
LIVEKIT_URL_HOST = your-project.livekit.cloud
